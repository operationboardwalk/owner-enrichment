# Copy this file to .env and fill in your values before running the script.
# The script reads ROCKETREACH_API_KEY directly from enrich_owners.py by default,
# but you can also load it from this .env file using python-dotenv.

ROCKETREACH_API_KEY=your_rocketreach_api_key_here

# Optional — used by generate_bov.py to auto-fetch Walk/Transit/Bike scores.
# Free tier: https://www.walkscore.com/professional/api-sign-up.php
# If unset, walkability is simply omitted (or you can fill it in the property JSON).
WALKSCORE_API_KEY=your_walkscore_api_key_here
